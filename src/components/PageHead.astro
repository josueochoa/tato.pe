---
/** The inner pages' top: wordmark left, a few links right. Plain, no bar. */
import { nav } from '../lib/site';
interface Props { title: string; intro?: string; }
const { title, intro } = Astro.props;
---
<header class="ph wrap">
  <a class="ph__mark small medium" href="/">Tato Studio</a>
  <nav class="ph__nav small medium" aria-label="Principal">
    {nav.filter((n) => n.label !== 'Blog').slice(0, 4).map((n) => <a class="link" href={n.href}>{n.label}</a>)}
    <a class="link" href="/blog">Blog</a>
  </nav>
  <h1 class="ph__title">{title}</h1>
  {(intro || Astro.slots.has('default')) && <p class="lead ph__intro">{intro}<slot /></p>}
</header>
<style>
  .ph { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); padding-top: 1.1rem; }
  .ph__mark { grid-column: 1 / span 4; text-decoration: none; }
  .ph__nav { grid-column: 5 / span 5; display: flex; gap: 1.5rem; }
  .ph__nav a { white-space: nowrap; }
  .ph__title { grid-column: 1 / span 9; margin-top: 18vh; font-size: clamp(3rem, 8vw, 8rem); line-height: 0.9; }
  .ph__intro { grid-column: 1 / span 6; margin-top: 1.5rem; }
  @media (max-width: 47.99em) {
    .ph { display: block; padding-inline: 16px; }
    .ph__nav { display: none; }
    .ph__title { margin-top: 12vh; font-size: 14vw; }
    .ph__intro { margin-top: 1.25rem; }
  }
</style>
