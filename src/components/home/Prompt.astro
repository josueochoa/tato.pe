---
import { site, wa } from '../../lib/site';
---
<section class="cta" id="prompt" data-ink="#ffffff">
  <img class="cta__img" src="/poster/afhs-joel.jpg" alt="Dos personas sentadas en un campo al atardecer, a contraluz" loading="lazy" decoding="async" width="1280" height="720" />
  <div class="cta__text">
    <h2 class="cta__line">Prompt de la semana, gratis</h2>
    <p class="cta__p" data-reveal>Cada semana comparto el prompt del video que está sonando, con los ajustes que uso. Te llega por WhatsApp o por correo.</p>
    <a class="button button--paper cta__button" href={wa('Hola Tato, quiero el prompt de la semana')} data-reveal style="--i:1">Recíbelo gratis</a>
    <form class="cta__form" action={`mailto:${site.email}`} method="get" data-reveal style="--i:2">
      <input type="hidden" name="subject" value="Quiero el prompt de la semana" />
      <label class="sr-only" for="prompt-email">Tu correo</label>
      <input class="cta__input" id="prompt-email" name="body" type="email" placeholder="o deja tu correo" autocomplete="email" />
      <button class="cta__send link-plain" type="submit">Enviar</button>
    </form>
  </div>
</section>

<style>
  .cta { position: relative; height: 90svh; overflow: hidden; background: var(--ink); color: var(--bg); }
  .cta__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 20% 50%; filter: brightness(0.75); transform: scale(1.25); transform-origin: 95% 50%; }
  .cta__text { position: absolute; left: calc(100% * 7 / 12 + var(--gutter)); right: var(--margin); bottom: 12svh; display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }
  .cta__line { font-size: clamp(1.75rem, 3.4vw, 3.25rem); max-width: 12ch; }
  .cta__p { max-width: 40ch; }
  .cta__button { min-height: 52px; }
  .cta__form { display: flex; gap: 1rem; align-items: center; }
  .cta__input { min-height: 44px; padding: 0 0.9rem; background: rgb(255 255 255 / 0.14); color: var(--bg); border: 0; min-width: 16rem; }
  .cta__input::placeholder { color: rgb(255 255 255 / 0.8); }
  .cta__input:focus-visible { outline: 2px solid var(--bg); }
  .cta__send { background: none; padding: 0; cursor: pointer; font-weight: 500; }
  @media (max-width: 63.99em) { .cta__text { left: calc(100% * 5 / 12); } }
  @media (max-width: 47.99em) {
    .cta { height: auto; }
    .cta__img { position: relative; height: 70svh; transform: none; object-position: 40% 50%; }
    .cta__text { position: static; padding: 2rem 16px 2.5rem; }
    .cta__line { font-size: 1.75rem; }
    .cta__button { width: 100%; }
    .cta__form { width: 100%; }
    .cta__input { flex: 1; min-width: 0; }
  }
</style>
