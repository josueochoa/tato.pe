---
import { site } from '../../lib/site';
const t = (id: string) => `${site.tiktok}/video/${id}`;
type Frame = { id: string; name: string; fact: string; portrait: boolean; alt: string; link?: string };
const lifted: Frame = { id: 'huacachina', name: 'Huacachina', fact: 'Para Valdelomar, Ica', portrait: true, alt: 'Un bulldog francés y un cuy con chullo en un bote en la laguna de Huacachina' };
const rest: Frame[] = [
  { id: 'valdelomar-cuy', name: 'El Cuy de Valdelomar', fact: 'Spot para restaurante', portrait: true, alt: 'Un cuy con chullo sentado a la mesa de un restaurante' },
  { id: 'pisco', name: 'Pisco', fact: 'Spot en 16:9', portrait: false, alt: 'Un hombre sentado a la barra de un bar frente a una fila de shots de pisco' },
  { id: 'pompinchu', name: 'Pompinchú', fact: 'Homenaje', portrait: true, alt: 'Un Pikachu con alas y aureola entre nubes al atardecer' },
  { id: 'valdelomar', name: 'Valdelomar', fact: 'Spot para restaurante', portrait: true, alt: 'Un cuy con chullo y poncho cruzado de brazos en un restaurante' },
  { id: 'transformacion', name: 'Transformación', fact: 'Seedance 2.0', portrait: true, alt: 'Un hombre con armadura blanca y ojos encendidos' },
  { id: 'afhs-joel', name: 'Joel y la enana', fact: 'Parodia, en TikTok', portrait: false, link: t('7696018218237906184'), alt: 'Dos personas sentadas en un campo al atardecer' },
  { id: 'afhs-balacera', name: 'Balacera en el barrio', fact: 'Parodia, en TikTok', portrait: false, link: t('7696018599131090183'), alt: 'Un hombre esquiva un auto en una calle de ladrillo' },
  { id: 'curwen', name: 'Curwen y Carlita', fact: 'Parodia, en TikTok', portrait: true, link: t('7562721279627889921'), alt: 'Un joven de rodillas pide matrimonio en una banca al atardecer' },
];
const all = [lifted, ...rest];
---
<section class="videos" id="videos" data-ink="#1f1f1f">
  <div class="videos__col">
    <h2 class="videos__head">Mis videos</h2>
    <a class="link-plain medium" href={site.tiktok}>Ver más en TikTok</a>
    <p class="small videos__note">Las vistas de cada video están en TikTok. Los personajes de TV los verás allá.</p>
    <p class="small videos__note">Los videos de clientes se muestran con su permiso.</p>
  </div>
  <div class="videos__scroll">
    <div class="videos__run">
      <figure class="frame frame--lifted" data-reveal="scale">
        <div class="frame__media">
          <video data-loop muted loop playsinline preload="metadata" poster={`/poster/${lifted.id}.jpg`} width="720" height="1280" aria-label={lifted.alt}>
            <source src={`/video/${lifted.id}.mp4`} type="video/mp4" />
          </video>
        </div>
        <figcaption class="frame__cap small"><span class="medium">{lifted.name}</span><span class="muted">{lifted.fact}</span></figcaption>
      </figure>
      <div class="videos__row">
        {rest.map((f, i) => (
          <figure class:list={['frame', { 'frame--wide': !f.portrait }]} data-reveal style={`--i:${Math.min(i + 1, 6)}`}>
            {f.link ? (
              <a class="frame__media" href={f.link} aria-label={`${f.name}, ver en TikTok`}>
                <img src={`/poster/${f.id}.jpg`} alt={f.alt} loading="lazy" decoding="async" width={f.portrait ? 720 : 1280} height={f.portrait ? 1280 : 720} />
              </a>
            ) : (
              <button class="frame__media" type="button" data-tap aria-label={`${f.name}, reproducir con sonido`}>
                <video muted loop playsinline preload="none" poster={`/poster/${f.id}.jpg`} width={f.portrait ? 720 : 1280} height={f.portrait ? 1280 : 720} aria-hidden="true">
                  <source src={`/video/${f.id}.mp4`} type="video/mp4" />
                </video>
                <span class="frame__play small">Ver</span>
              </button>
            )}
            <figcaption class="frame__cap small"><span class="medium">{f.name}</span><span class="muted">{f.fact}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
  <ol class="videos__list small">
    {all.map((f) => <li><span class="medium">{f.name}</span> <span class="muted">{f.fact}</span></li>)}
  </ol>
</section>

<style>
  .videos { display: grid; grid-template-columns: 3fr 9fr; column-gap: var(--gutter); padding: calc(var(--section) / 2) 0 calc(var(--section) / 2) var(--margin); background: var(--bg); align-items: end; }
  .videos__col { display: flex; flex-direction: column; gap: 0.75rem; align-self: stretch; padding-bottom: 2rem; }
  .videos__head { font-size: 1.75rem; }
  .videos__note { margin-top: auto; max-width: 26ch; }
  .videos__note + .videos__note { margin-top: 0.5rem; }
  .videos__scroll { overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x proximity; scrollbar-width: none; }
  .videos__scroll::-webkit-scrollbar { display: none; }
  .videos__run { display: flex; align-items: flex-end; gap: 6px; width: max-content; padding-right: var(--margin); }
  .videos__row { display: contents; }
  .videos__list { display: none; }
  .frame { margin: 0; scroll-snap-align: start; --h: 30vh; }
  .frame--lifted { --h: 66vh; }
  .frame__media { display: block; height: var(--h); aspect-ratio: 9 / 16; overflow: hidden; background: var(--ink); position: relative; padding: 0; cursor: pointer; }
  .frame--wide .frame__media { aspect-ratio: 16 / 9; }
  .frame__media img, .frame__media video { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease-soft); }
  @media (hover: hover) and (pointer: fine) { .frame__media:hover img, .frame__media:hover video { transform: scale(1.04); } }
  .frame__play { position: absolute; left: 10px; bottom: 10px; background: var(--bg); color: var(--ink); padding: 0.25rem 0.6rem; font-weight: 500; }
  .is-sound .frame__play { background: var(--ink); color: var(--bg); }
  .frame__cap { display: flex; flex-direction: column; gap: 0; padding-top: 0.5rem; white-space: normal; }
  .frame--wide .frame__cap, .frame--lifted .frame__cap { flex-direction: row; justify-content: space-between; gap: 1rem; }

  @media (max-width: 47.99em) {
    .videos { display: block; padding: calc(var(--section) / 2) 0; }
    .videos__col { padding: 0 16px 1.25rem; }
    .videos__note { display: none; }
    .videos__scroll { overflow: visible; }
    .videos__run { display: block; width: auto; padding: 0; }
    .frame--lifted { margin: 0 16px 1rem; }
    .frame--lifted .frame__media { height: auto; width: 100%; }
    .videos__row { display: flex; gap: 4px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0 16px; scrollbar-width: none; }
    .videos__row::-webkit-scrollbar { display: none; }
    .frame { --h: 34vw; flex: none; }
    .videos__row .frame__cap { display: none; }
    .frame--lifted .frame__cap { display: none; }
    .videos__list { display: block; list-style: none; padding: 1.25rem 16px 0; margin: 0; columns: 2; column-gap: 16px; }
    .videos__list li { break-inside: avoid; padding-bottom: 0.4rem; display: flex; flex-direction: column; }
  }
</style>
