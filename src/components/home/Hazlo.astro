---
import { site } from '../../lib/site';
const steps = [
  { verb: 'Escribe', text: 'Un prompt es una descripción: quién sale, qué pasa, cómo se ve. Yo te doy los míos.', img: 'pisco', alt: 'Una pareja brinda con shots de pisco en un bar de noche', wide: true },
  { verb: 'Genera', text: 'Uso Higgsfield. Con mi link tienes descuento; es un link de afiliado.', img: 'afhs-balacera', alt: 'Un hombre esquiva un auto en una calle de ladrillo', wide: true },
  { verb: 'Publica', text: 'Súbelo a TikTok con el sonido que esté sonando. Así empecé yo.', img: 'huacachina', alt: 'Un bulldog francés y un cuy con chullo en la laguna de Huacachina', wide: false, last: true },
];
---
<section class="hazlo" id="hazlo" aria-labelledby="hazlo-title" data-ink="#ffffff">
  <h2 class="sr-only" id="hazlo-title">Hazlo tú mismo</h2>
  {steps.map((s) => (
    <div class="panel">
      <img class="panel__img" src={`/poster/${s.img}.jpg`} alt={s.alt} loading="lazy" decoding="async" width={s.wide ? 1280 : 720} height={s.wide ? 720 : 1280} />
      <div class="panel__pin"><p class="panel__verb">{s.verb}</p></div>
      <div class="panel__foot">
        <p class="panel__text">{s.text}</p>
        {s.last && (
          <div class="panel__cta">
            <a class="button button--paper" href={site.higgsfield} rel="sponsored noopener">Probar la app</a>
            <p class="small">Link de afiliado: si compras con él, yo gano una comisión y tú no pagas más.</p>
          </div>
        )}
      </div>
    </div>
  ))}
</section>

<style>
  .hazlo { background: var(--ink); color: var(--bg); }
  .panel { position: relative; height: 100svh; overflow: hidden; }
  .panel__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(0.7); }
  .panel__pin { position: sticky; top: 50%; transform: translateY(-50%); text-align: center; pointer-events: none; }
  .panel__verb { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: clamp(6rem, 17vw, 18.75rem); line-height: 0.85; letter-spacing: -0.03em; color: var(--bg); }
  .panel__foot { position: absolute; left: 0; bottom: 0; display: flex; align-items: flex-end; gap: 2rem; flex-wrap: wrap; max-width: 100%; }
  .panel__text { font-size: var(--step-body); line-height: 1.45; max-width: 34ch; background: rgb(31 31 31 / 0.6); padding: 1.25rem var(--margin) 1.25rem var(--margin); margin: 0; }
  .panel__cta { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; background: rgb(31 31 31 / 0.6); padding: 1rem var(--margin) 1.25rem; }
  .panel__cta p { max-width: 32ch; margin: 0; }
  @media (max-width: 47.99em) {
    .panel__verb { font-size: 17vw; }
    .panel__foot { flex-direction: column; align-items: stretch; gap: 0; width: 100%; }
    .panel__text { font-size: 1rem; max-width: 100%; padding: 1rem 16px; }
    .panel__cta { padding: 0 16px 1.25rem; }
  }
</style>
