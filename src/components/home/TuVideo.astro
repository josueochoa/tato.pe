---
import { plans, occasions, styles, site, wa } from '../../lib/site';
const def = plans[1];
const message = (p: (typeof plans)[number], who = 'mi pareja', style = 'Zombie Love') =>
  `Hola Tato, quiero mi video ${style} para ${who}. Plan ${p.name} (${p.res}, ${p.tries} intentos, entrega en ${p.days} días) a S/${p.price}. Tengo permiso de las personas que salen en las fotos.`;
const dots = Array.from({ length: 16 });
---
<section class="tuvideo" id="tu-video" data-ink="#1f1f1f" style="--ground: #fbbc05">
  <div class="tuvideo__head wrap">
    <h2 class="head" data-reveal>Te lo hago yo</h2>
    <p class="lead" data-reveal style="--i:1">Un video con IA de tu pareja, tu familia o el cumpleaños de alguien. Me mandas las fotos por WhatsApp y te lo entrego ahí mismo.</p>
  </div>

  <form class="tuvideo__form wrap" data-tuvideo aria-label="Escribe tu video">
    <div class="tuvideo__fields">
      <fieldset class="opts">
        <legend class="medium">Para quién</legend>
        {occasions.map((o, i) => (
          <label class="opt"><input type="radio" name="who" value={o} checked={i === 0} /><span>{o}</span></label>
        ))}
      </fieldset>
      <fieldset class="opts">
        <legend class="medium">Estilo</legend>
        {styles.map((s, i) => (
          <label class="opt"><input type="radio" name="style" value={s} checked={i === 0} /><span>{s}</span></label>
        ))}
      </fieldset>
      <fieldset class="opts opts--plans">
        <legend class="medium">Plan</legend>
        {plans.map((p) => (
          <label class="opt opt--plan">
            <input type="radio" name="plan" value={p.id} checked={p.id === def.id} data-price={p.price} data-res={p.res} data-tries={p.tries} data-days={p.days} data-note={p.note} data-name={p.name} />
            <span class="opt__plan"><span class="medium">{p.name} · {p.res}</span><span class="nums">S/{p.price}</span><span class="small">{p.tries} intentos · {p.days} días · {p.note}</span></span>
          </label>
        ))}
      </fieldset>
      <label class="check"><input type="checkbox" name="permiso" checked /><span>Tengo permiso de las personas que salen en las fotos.</span></label>
      <p class="small tuvideo__note">Precios referenciales en soles. Pago por Yape, Plin o tarjeta al confirmar.</p>
    </div>

    <article class="ticket" aria-live="polite">
      <div class="ticket__main">
        <h3 class="ticket__title" data-tv-title>Zombie Love para tu pareja</h3>
        <ul class="ticket__lines">
          <li data-tv-res>Resolución {def.res}</li>
          <li data-tv-tries>{def.tries} intentos incluidos</li>
          <li data-tv-days>Entrega en {def.days} días</li>
          <li data-tv-note>{def.note}</li>
        </ul>
      </div>
      <div class="ticket__perf" aria-hidden="true">
        <span class="ticket__notch ticket__notch--a"></span>
        {dots.map(() => <i></i>)}
        <span class="ticket__notch ticket__notch--b"></span>
      </div>
      <div class="ticket__stub">
        <div class="ticket__pricebox"><p class="ticket__price nums" data-tv-price>S/{def.price}</p></div>
        <a class="ticket__action" href={wa(message(def))} data-tv-link>Pedir por WhatsApp</a>
      </div>
    </article>
  </form>
</section>

<style>
  .tuvideo { background: var(--ground); color: var(--ink); padding: calc(var(--section) / 2) 0; }
  .tuvideo__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: end; margin-bottom: 3.5rem; }
  .tuvideo__head h2 { grid-column: 1 / span 6; }
  .tuvideo__head .lead { grid-column: 8 / span 5; max-width: 36ch; }
  .tuvideo__form { display: grid; grid-template-columns: 5fr 7fr; column-gap: calc(var(--gutter) * 2); align-items: start; }
  .tuvideo__fields { display: flex; flex-direction: column; gap: 1.75rem; }
  .opts { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .opts legend { padding: 0; margin-bottom: 0.6rem; float: left; width: 100%; }
  .opt { position: relative; cursor: pointer; }
  .opt input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .opt > span { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1rem; background: var(--bg); color: var(--ink); transition: background-color var(--t-hover) ease, color var(--t-hover) ease, transform var(--t-press) var(--ease-out); }
  .opt input:checked + span { background: var(--ink); color: var(--bg); }
  .opt input:focus-visible + span { outline: 2px solid var(--ink); outline-offset: 2px; }
  .opt:active > span { transform: scale(0.97); }
  .opts--plans { flex-direction: column; }
  .opt--plan, .opt--plan > span { width: 100%; }
  .opt__plan { display: grid !important; grid-template-columns: 1fr auto; padding: 0.75rem 1rem !important; row-gap: 0.1rem; }
  .opt__plan .small { grid-column: 1 / -1; opacity: 0.8; }
  .check { display: flex; gap: 0.75rem; align-items: flex-start; cursor: pointer; max-width: 40ch; }
  .check input { width: 1.25rem; height: 1.25rem; margin-top: 0.2rem; accent-color: var(--ink); flex: none; }
  .tuvideo__note { max-width: 40ch; }

  /* the ticket, dark on the yellow field */
  .ticket { --paper: var(--ink); --tink: var(--bg); position: sticky; top: 2rem; display: grid; grid-template-columns: 7fr 28px 3fr; aspect-ratio: 2.1; background: var(--paper); color: var(--tink); }
  .ticket__main { display: flex; flex-direction: column; justify-content: space-between; padding: 36px; min-width: 0; }
  .ticket__title { font-size: clamp(1.5rem, 2.6vw, 2.5rem); }
  .ticket__lines { list-style: none; padding: 0; margin: 1.5rem 0 0; columns: 2; column-gap: 2rem; line-height: 1.4; }
  .ticket__lines li { break-inside: avoid; padding-bottom: 0.3rem; }
  .ticket__perf { position: relative; display: flex; flex-direction: column; justify-content: space-evenly; align-items: center; }
  .ticket__perf i { display: block; width: 6px; height: 6px; border-radius: 50%; background: var(--ground); }
  .ticket__notch { position: absolute; left: 0; width: 28px; height: 28px; border-radius: 50%; background: var(--ground); }
  .ticket__notch--a { top: -14px; }
  .ticket__notch--b { bottom: -14px; }
  .ticket__stub { display: flex; flex-direction: column; align-items: stretch; justify-content: space-between; padding: 32px 20px 0; background: var(--color-red); color: var(--bg); min-width: 0; }
  .ticket__pricebox { display: flex; justify-content: center; }
  .ticket__price { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.5rem, 6vw, 5.5rem); line-height: 0.9; letter-spacing: -0.03em; text-align: center; }
  .ticket__action { align-self: stretch; display: flex; align-items: center; justify-content: center; min-height: 56px; padding: 0 1rem; background: var(--bg); color: var(--ink); font-weight: 500; text-decoration: none; text-align: center; transition: transform var(--t-press) var(--ease-out), background-color var(--t-hover) ease; }
  .ticket__action:active { transform: scale(0.98); }
  .ticket__action[aria-disabled="true"] { opacity: 0.6; }
  @media (hover: hover) and (pointer: fine) { .ticket__action:hover { background: var(--surface); } }

  @media (max-width: 63.99em) {
    .tuvideo__head { display: block; margin-bottom: 2rem; }
    .tuvideo__head .lead { margin-top: 1rem; }
    .tuvideo__head .lead { margin-top: 1rem; }
    .tuvideo__form { display: block; }
    .ticket { position: static; margin-top: 2.5rem; grid-template-columns: 1fr; grid-template-rows: auto auto auto 28px auto; grid-template-areas: "title" "price" "lines" "perf" "action"; aspect-ratio: auto; }
    .ticket__main, .ticket__stub { display: contents; }
    .ticket__title { grid-area: title; padding: 24px 20px 0; font-size: clamp(1.5rem, 5.6vw, 2.5rem); }
    .ticket__pricebox { grid-area: price; padding: 12px 20px 0; justify-content: flex-start; }
    .ticket__price { font-size: clamp(2.25rem, 10vw, 4rem); text-align: left; }
    .ticket__lines { grid-area: lines; columns: 1; margin: 1rem 0 0; padding: 0 20px 16px; }
    .ticket__perf { grid-area: perf; flex-direction: row; }
    .ticket__notch { left: auto; top: 0; }
    .ticket__notch--a { left: -14px; }
    .ticket__notch--b { right: -14px; }
    .ticket__action { grid-area: action; margin: 16px 20px 20px; background: var(--color-red); color: var(--bg); }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-tuvideo]');
  if (form) {
    const q = (s: string) => form.querySelector<HTMLElement>(s)!;
    const link = q('[data-tv-link]') as HTMLAnchorElement;
    const number = '51961662512';
    const whoText: Record<string, string> = { Pareja: 'tu pareja', Familia: 'tu familia', Cumpleaños: 'un cumpleaños', Otro: 'alguien' };
    const whoMsg: Record<string, string> = { Pareja: 'mi pareja', Familia: 'mi familia', Cumpleaños: 'un cumpleaños', Otro: 'alguien' };
    const paint = () => {
      const who = (form.querySelector('input[name="who"]:checked') as HTMLInputElement).value;
      const style = (form.querySelector('input[name="style"]:checked') as HTMLInputElement).value;
      const plan = form.querySelector('input[name="plan"]:checked') as HTMLInputElement;
      const ok = (form.querySelector('input[name="permiso"]') as HTMLInputElement).checked;
      const d = plan.dataset;
      q('[data-tv-title]').textContent = `${style} para ${whoText[who]}`;
      q('[data-tv-res]').textContent = `Resolución ${d.res}`;
      q('[data-tv-tries]').textContent = `${d.tries} intentos incluidos`;
      q('[data-tv-days]').textContent = `Entrega en ${d.days} días`;
      q('[data-tv-note]').textContent = d.note || '';
      q('[data-tv-price]').textContent = `S/${d.price}`;
      const msg = `Hola Tato, quiero mi video ${style} para ${whoMsg[who]}. Plan ${d.name} (${d.res}, ${d.tries} intentos, entrega en ${d.days} días) a S/${d.price}.` + (ok ? ' Tengo permiso de las personas que salen en las fotos.' : ' Aún debo confirmar el permiso de imagen.');
      link.href = `https://wa.me/${number}?text=${encodeURIComponent(msg)}`;
      link.setAttribute('aria-disabled', ok ? 'false' : 'true');
      link.textContent = ok ? 'Pedir por WhatsApp' : 'Marca el permiso para pedir';
    };
    form.addEventListener('change', paint);
    link.addEventListener('click', (e) => { if (link.getAttribute('aria-disabled') === 'true') { e.preventDefault(); (form.querySelector('input[name="permiso"]') as HTMLInputElement).focus(); } });
    paint();
  }
</script>
