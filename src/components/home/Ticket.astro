---
/** A price printed on a ticket. Two-part grid, half-round notches at the seam, a dotted perforation. */
interface Props {
  title: string;
  titleHref?: string;
  lines: string[];
  price: number;
  compareAt?: number;
  priceNote?: string;
  action: string;
  href?: string;
  add?: string;           // product slug: the action adds to the cart
  id?: string;
}
const { title, titleHref, lines, price, compareAt, priceNote, action, href, add, id } = Astro.props;
const dots = Array.from({ length: 16 });
---
<article class="ticket" id={id}>
  <div class="ticket__main">
    <h3 class="ticket__title">{titleHref ? <a href={titleHref}>{title}</a> : title}</h3>
    <ul class="ticket__lines">
      {lines.map((l) => <li>{l}</li>)}
    </ul>
  </div>
  <div class="ticket__perf" aria-hidden="true">
    <span class="ticket__notch ticket__notch--a"></span>
    {dots.map(() => <i></i>)}
    <span class="ticket__notch ticket__notch--b"></span>
  </div>
  <div class="ticket__stub">
    <div class="ticket__pricebox">
      <p class="ticket__price nums">
        <span>S/{price}</span>
        {compareAt && <s class="ticket__compare">S/{compareAt}</s>}
      </p>
      {priceNote && <p class="ticket__pricenote small">{priceNote}</p>}
    </div>
    {add ? (
      <button class="ticket__action" type="button" data-add={add}>{action}</button>
    ) : (
      <a class="ticket__action" href={href}>{action}</a>
    )}
  </div>
</article>

<style>
  .ticket { position: relative; display: grid; grid-template-columns: 7fr 28px 3fr; width: min(64vw, 1100px); margin-inline: auto; aspect-ratio: 2.3; background: var(--bg); color: var(--ink); }
  .ticket__main { display: flex; flex-direction: column; justify-content: space-between; padding: 40px; min-width: 0; }
  .ticket__title { font-size: clamp(1.5rem, 2.6vw, 2.5rem); }
  .ticket__title a { text-decoration: none; }
  .ticket__lines { list-style: none; padding: 0; margin: 2rem 0 0; columns: 2; column-gap: 2rem; font-size: var(--step-body); line-height: 1.4; }
  .ticket__lines li { break-inside: avoid; padding-bottom: 0.35rem; }
  .ticket__perf { position: relative; display: flex; flex-direction: column; justify-content: space-evenly; align-items: center; }
  .ticket__perf i { display: block; width: 6px; height: 6px; border-radius: 50%; background: var(--ground); }
  .ticket__notch { position: absolute; left: 0; width: 28px; height: 28px; border-radius: 50%; background: var(--ground); }
  .ticket__notch--a { top: -14px; }
  .ticket__notch--b { bottom: -14px; }
  .ticket__stub { display: flex; flex-direction: column; align-items: stretch; justify-content: space-between; padding: 32px 24px 0; min-width: 0; }
  .ticket__pricebox { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .ticket__price { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.5rem, 6vw, 5.5rem); line-height: 0.9; letter-spacing: -0.03em; text-align: center; display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 0.2em 0.35em; }
  .ticket__compare { font-size: 0.42em; letter-spacing: 0; text-decoration-thickness: 0.12em; opacity: 0.7; }
  .ticket__action { display: flex; align-items: center; justify-content: center; min-height: 56px; padding: 0 1rem; background: var(--ink); color: var(--bg); font-weight: 500; text-decoration: none; text-align: center; cursor: pointer; transition: transform var(--t-press) var(--ease-out), filter var(--t-hover) ease; }
  .ticket__action:active { transform: scale(0.98); }
  @media (hover: hover) and (pointer: fine) { .ticket__action:hover { filter: brightness(1.25); } }

  /* upright: title and price share the top row, the perforation runs across, the action closes the stub */
  @media (max-width: 63.99em) {
    .ticket { grid-template-columns: 1fr; grid-template-rows: auto auto auto 28px auto; grid-template-areas: "title" "price" "lines" "perf" "action"; width: calc(100% - 40px); aspect-ratio: auto; }
    .ticket__main, .ticket__stub { display: contents; }
    .ticket__title { grid-area: title; padding: 28px 24px 0; font-size: clamp(1.5rem, 5.6vw, 2.5rem); }
    .ticket__pricebox { grid-area: price; padding: 12px 24px 0; align-items: flex-start; }
    .ticket__price { font-size: clamp(2.25rem, 10vw, 4rem); justify-content: flex-start; text-align: left; }
    .ticket__lines { grid-area: lines; columns: 1; margin: 1.25rem 0 0; padding: 0 24px 20px; }
    .ticket__perf { grid-area: perf; flex-direction: row; }
    .ticket__notch { left: auto; top: 0; }
    .ticket__notch--a { left: -14px; }
    .ticket__notch--b { right: -14px; }
    .ticket__action { grid-area: action; margin: 20px 24px 24px; }
  }
</style>
