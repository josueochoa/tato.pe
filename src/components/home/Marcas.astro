---
import { site, wa } from '../../lib/site';
---
<section class="marcas" id="marcas" data-ink="#ffffff">
  <img class="marcas__img" src="/poster/valdelomar.jpg" alt="El Cuy de Valdelomar, con chullo y poncho, sentado a la mesa de un restaurante en Ica" loading="lazy" decoding="async" width="720" height="1280" />
  <div class="card" data-reveal="right">
    <h2 class="card__title">Para marcas</h2>
    <p class="card__lines">Videos con IA para negocios y talleres para equipos.<br />Con <a class="link-plain" href={site.agentia}>Agentia</a>, desde Lima.</p>
    <dl class="card__rows nums">
      <div><dt>Video para redes</dt><dd>desde 3 días</dd></div>
      <div><dt>Taller para equipos</dt><dd>medio día</dd></div>
      <div><dt>Campaña completa</dt><dd>a cotizar</dd></div>
    </dl>
    <p class="card__phone"><a class="link-plain" href={`https://wa.me/${site.whatsappNumber}`}>+51 961 662 512</a></p>
    <a class="button button--ink button--wide" href={wa('Hola Tato, quiero cotizar videos con IA para mi marca')}>Cotizar</a>
  </div>
</section>

<style>
  .marcas { position: relative; height: 100svh; overflow: hidden; background: var(--ink); }
  .marcas__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 32% 40%; }
  .card { position: absolute; top: 60px; left: 60px; width: 380px; max-width: calc(100% - 32px); background: var(--bg); color: var(--ink); padding: 32px 32px 0; display: flex; flex-direction: column; gap: 1rem; }
  .card__title { font-size: 1.75rem; }
  .card__lines { font-size: var(--step-small); line-height: 1.45; }
  .card__rows { display: flex; flex-direction: column; gap: 0.4rem; margin: 0.25rem 0; }
  .card__rows div { display: flex; justify-content: space-between; gap: 1rem; }
  .card__rows dd { margin: 0; text-align: right; }
  .card__phone { font-size: var(--step-small); }
  .card .button { margin: 0.75rem -32px 0; min-height: 52px; }
  @media (max-width: 47.99em) {
    .marcas { height: auto; }
    .marcas__img { position: relative; height: 70svh; }
    .card { position: relative; top: auto; left: auto; width: auto; margin: -80px 16px 0; padding: 24px 24px 0; }
    .card .button { margin: 0.75rem -24px 0; min-height: 56px; }
  }
</style>
