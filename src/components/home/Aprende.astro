---
import { getCollection } from 'astro:content';
import Ticket from './Ticket.astro';
const products = (await getCollection('products', ({ data }) => data.available)).sort((a, b) => a.data.order - b.data.order);
const linesFor = (p: (typeof products)[number]) => {
  const d = p.data;
  const extra = [d.when, d.seats ? `${d.seats} cupos` : undefined, d.availableFrom].filter(Boolean) as string[];
  return [...extra, ...d.includes.filter((l) => !/cupos/i.test(l))].slice(0, 4);
};
---
<section class="aprende" id="aprende" data-ink="#ffffff" style="--ground: #4285f4">
  <div class="aprende__head wrap">
    <h2 class="head" data-reveal>Aprende a hacerlo</h2>
    <p class="lead" data-reveal style="--i:1">Lo que más me preguntan es cómo. Esto es lo que hay para aprenderlo conmigo, con precios en soles y pago por Yape, Plin o tarjeta.</p>
  </div>
  <div class="aprende__tickets">
    {products.map((p, i) => (
      <div data-reveal="scale" style={`--i:${i}`}>
        <Ticket
          title={p.data.title}
          titleHref={`/aprende/${p.id}`}
          lines={linesFor(p)}
          price={p.data.price}
          compareAt={p.data.compareAt}
          priceNote={p.data.kind === 'taller' ? 'preventa' : undefined}
          action={p.data.cta}
          add={p.id}
        />
      </div>
    ))}
  </div>
  <p class="aprende__soon wrap" data-reveal>Pronto: un curso completo y un club con prompts cada semana. <a class="link-plain" href="#prompt">Déjame tu correo</a> y te aviso.</p>
</section>

<style>
  .aprende { background: var(--ground); color: var(--bg); padding: calc(var(--section) / 2) 0 calc(var(--section) / 2); }
  .aprende__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: end; margin-bottom: 4rem; }
  .aprende__head h2 { grid-column: 1 / span 6; }
  .aprende__head .lead { grid-column: 8 / span 5; max-width: 36ch; color: var(--ink); }
  .aprende__tickets { display: flex; flex-direction: column; gap: 3rem; }
  .aprende__soon { margin-top: 4rem; max-width: 100%; text-align: center; color: var(--ink); }
  @media (max-width: 63.99em) { .aprende__head { align-items: start; } }
  @media (max-width: 47.99em) {
    .aprende__head { display: block; margin-bottom: 2.5rem; }
    .aprende__head .lead { margin-top: 1rem; }
    .aprende__tickets { gap: 2rem; }
    .aprende__soon { margin-top: 2.5rem; text-align: left; }
  }
</style>
