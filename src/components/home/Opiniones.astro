---
/** SAMPLE CONTENT: the quotations here are examples and must be replaced with real ones before launch. */
const steps = [
  { quote: 'Hice mi primer video zombie la misma noche del taller.', who: 'Alumna del taller, Lima (ejemplo)', img: '/poster/pompinchu.jpg', alt: 'Un Pikachu con alas y aureola entre nubes' },
  { quote: 'El video de nuestra boda lo vieron más personas que la boda.', who: 'Cliente de video personalizado (ejemplo)', img: '/poster/afhs-joel.jpg', alt: 'Dos personas en un campo al atardecer' },
  { quote: 'Nos trajo gente al local en una semana.', who: 'Restaurante en Ica (ejemplo)', img: '/poster/valdelomar-cuy.jpg', alt: 'Un cuy con chullo sentado a la mesa de un restaurante' },
];
---
<section class="op" id="opiniones" data-ink="#1f1f1f" data-steps>
  <div class="op__stage">
    <h2 class="op__title">Opiniones</h2>
    <div class="op__frame">
      {steps.map((s, i) => (
        <img class:list={['op__img', { 'is-on': i === 0 }]} data-slide={i + 1} src={s.img} alt={s.alt} loading="lazy" decoding="async" width="720" height="1280" />
      ))}
    </div>
    {steps.map((s, i) => (
      <blockquote class:list={['op__quote', `op__quote--${i + 1}`, { 'is-on': i === 0 }]} data-slide={i + 1}>
        <p class="op__q">{s.quote}</p>
        <footer class="op__who small">{s.who}</footer>
      </blockquote>
    ))}
  </div>
  <div class="op__steps" aria-hidden="true">
    {steps.map((_, i) => <div class="op__step" data-step={i + 1}></div>)}
  </div>

  <div class="op__mobile">
    <h2 class="op__mtitle">Opiniones</h2>
    {steps.map((s, i) => (
      <figure class:list={['op__block', i % 2 ? 'op__block--right' : '']} data-reveal>
        <img src={s.img} alt={s.alt} loading="lazy" decoding="async" width="720" height="1280" />
        <figcaption>
          <p class="op__q">{s.quote}</p>
          <p class="op__who small">{s.who}</p>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .op { position: relative; background: var(--color-green); color: var(--ink); }
  .op__stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .op__title { position: absolute; top: 24px; left: 0; right: 0; text-align: center; font-size: clamp(4rem, 11vw, 10rem); line-height: 0.85; }
  .op__frame { position: absolute; left: 50%; top: 54%; transform: translate(-50%, -50%); width: 30vw; max-width: 460px; aspect-ratio: 4 / 5; background: var(--ink); overflow: hidden; }
  .op__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 600ms var(--ease-soft); }
  .op__img.is-on { opacity: 1; }
  .op__quote { position: absolute; width: 280px; margin: 0; opacity: 0; transform: translateY(16px); transition: opacity 500ms var(--ease-out), transform 700ms var(--ease-out); }
  .op__quote.is-on { opacity: 1; transform: none; }
  .op__quote--1 { right: var(--margin); top: 28%; }
  .op__quote--2 { left: var(--margin); top: 50%; }
  .op__quote--3 { right: var(--margin); top: 68%; }
  .op__q { font-size: 1.375rem; font-weight: 500; line-height: 1.25; max-width: 100%; }
  .op__who { margin-top: 0.6rem; opacity: 0.8; }
  .op__steps { margin-top: -100svh; }
  .op__step { height: 65svh; }
  .op__step:first-child { height: 100svh; }
  .op__step:last-child { height: 95svh; }
  .op__mobile { display: none; }
  @media (max-width: 47.99em) {
    .op__stage, .op__steps { display: none; }
    .op__mobile { display: block; padding: 2.5rem 16px 3rem; }
    .op__mtitle { font-size: 12vw; margin-bottom: 2rem; }
    .op__block { margin: 0 0 72px; width: 72%; }
    .op__block--right { margin-left: auto; }
    .op__block img { aspect-ratio: 4 / 5; object-fit: cover; }
    .op__block figcaption { margin-top: 0.75rem; }
    .op__block .op__q { font-size: 1.25rem; }
  }
</style>
