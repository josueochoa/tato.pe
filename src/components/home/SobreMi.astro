---
import { site } from '../../lib/site';
const portraits = [
  { src: '/poster/gym.jpg', w: 720, h: 1280, alt: 'Carlos entrenando con mancuernas en un gimnasio', name: 'Carlos Quispe', role: 'Tato', text: 'Entreno en Huaraz. De ahí salió mi primer video viral: yo mismo, en el gym, convertido en un héroe.' },
  { src: '/found/quebrada-de-llaca-de-huaraz.jpg', w: 1536, h: 2048, alt: 'La quebrada de Llaca en Huaraz, con flores de lupino y nevados al fondo', name: 'Huaraz', role: 'donde empecé', text: 'A tres mil metros, con internet de pueblo, escribí prompts hasta que los videos salieron como quería.' },
  { src: '/found/atardecer-en-huacachina-2.jpg', w: 1920, h: 3140, alt: 'Una persona sobre una duna de Huacachina al anochecer', name: 'Ica', role: 'donde grabo con clientes', text: 'Aquí están Valdelomar, el cuy y la laguna. Mis primeros videos para negocios fueron para gente de acá.' },
  { src: '/found/jr-ucayali-centro-de-lima-17.jpg', w: 1920, h: 2560, alt: 'Portada colonial de una casona amarilla en el jirón Ucayali, centro de Lima', name: 'Lima', role: 'donde doy talleres', text: 'Los talleres en vivo y los trabajos para marcas los hago desde Lima, con Agentia.' },
];
---
<section class="about" id="sobre-mi" data-ink="#1f1f1f">
  <div class="about__pin" aria-hidden="true"><span class="about__title">Sobre mí</span></div>
  <h2 class="sr-only">Sobre mí</h2>
  <div class="about__flow">
    {portraits.map((p, i) => (
      <figure class:list={['portrait', i % 2 ? 'portrait--right' : 'portrait--left']}>
        <div class="portrait__img shutter" data-reveal>
          <img src={p.src} alt={p.alt} loading="lazy" decoding="async" width={p.w} height={p.h} />
        </div>
        <figcaption class="portrait__cap">
          <p class="portrait__name medium">{p.name}</p>
          <p class="portrait__role small muted">{p.role}</p>
          <p class="portrait__text">{p.text}</p>
        </figcaption>
      </figure>
    ))}
    <div class="about__end">
      <a class="button" href={site.tiktok}>Sígueme</a>
    </div>
  </div>
</section>

<style>
  .about { position: relative; background: var(--bg); }
  .about__pin { position: sticky; top: 0; height: 100svh; display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 3; }
  .about__title { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: clamp(5.5rem, 12vw, 11.25rem); line-height: 0.85; letter-spacing: -0.03em; color: var(--ink); background: var(--bg); padding: 0.12em 0.18em 0.06em; }
  .about__flow { margin-top: -100svh; padding-top: 20svh; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); padding-inline: var(--margin); }
  .portrait { margin: 0; width: 100%; }
  .portrait--left { grid-column: 2 / span 4; }
  .portrait--right { grid-column: 8 / span 4; }
  .portrait + .portrait { margin-top: 55svh; }
  .portrait__img { aspect-ratio: 4 / 5; overflow: hidden; background: var(--surface); }
  .portrait__img img { width: 100%; height: 100%; object-fit: cover; }
  .portrait__cap { margin-top: 0.75rem; max-width: 280px; }
  .portrait__name { font-size: var(--step-body); }
  .portrait__text { margin-top: 0.5rem; }
  .about__end { grid-column: 1 / -1; padding: 40svh 0 calc(var(--section) / 2); display: flex; justify-content: center; }
  @media (max-width: 47.99em) {
    .about { padding-top: 5.5rem; }
    .about__pin { position: static; height: auto; align-items: flex-start; padding: 0 16px; }
    .about__title { padding: 0; }
    .about__title { font-size: 17vw; }
    .about__flow { margin-top: 0; padding-top: 3rem; display: flex; flex-direction: column; gap: 48px; padding-inline: 16px; }
    .portrait { width: 72%; }
    .portrait--right { align-self: flex-end; }
    .portrait + .portrait { margin-top: 0; }
    .portrait__cap { max-width: 100%; }
    .about__end { padding: 2rem 0 3rem; justify-content: flex-start; }
  }
</style>
