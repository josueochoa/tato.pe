---
/**
 * The blog's map: one block per category, each in its brand colour, plus Todo in ink.
 * On a category page only that block keeps its colour, so you always see where you are.
 * Plain links: they work without JavaScript and every category has its own page.
 */
import { categories, categoryHref } from '../../lib/blog';
import type { Post } from '../../lib/posts';
interface Props { posts: Post[]; current?: string; }
const { posts, current } = Astro.props;
const items = categories.filter((c) => posts.some((p) => p.data.category === c.id));
---
<nav class="band wrap" aria-label="Categorías del blog">
  <a class:list={['band__item', 'band__item--all', { 'is-dim': current }]} href="/blog" aria-current={current ? undefined : 'page'}>Todo</a>
  {items.map((c) => (
    <a class:list={['band__item', { 'is-dim': current && current !== c.id }]} href={categoryHref(c.id)} style={`--cat:${c.color}`} aria-current={current === c.id ? 'page' : undefined}>{c.label}</a>
  ))}
</nav>
<style>
  .band { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: var(--gutter); margin-top: 3.5rem; view-transition-name: blog-band; }
  .band__item {
    display: flex; align-items: flex-end; min-height: clamp(5.5rem, 9vw, 9rem); padding: 1rem 1.1rem;
    background: var(--cat); color: var(--ink); text-decoration: none;
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: -0.03em; line-height: 1;
    font-size: clamp(1.2rem, 1.8vw, 2rem);
    transition: transform var(--t-hover) var(--ease-out), background-color var(--t-ui) ease, color var(--t-ui) ease;
  }
  .band__item--all { background: var(--ink); color: var(--bg); }
  .band__item.is-dim { background: var(--surface); color: var(--ink); }
  .band__item:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) {
    .band__item:hover { transform: translateY(-5px); }
    .band__item.is-dim:hover { background: var(--cat, var(--ink)); color: var(--ink); }
    .band__item--all.is-dim:hover { color: var(--bg); }
  }
  @media (max-width: 47.99em) {
    .band { grid-auto-columns: max-content; gap: 0.6rem; margin-top: 2.25rem; padding-inline: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 16px; scrollbar-width: none; }
    .band::-webkit-scrollbar { display: none; }
    .band__item { min-width: 40vw; min-height: 5rem; padding: 0.85rem 0.9rem; font-size: 1.2rem; scroll-snap-align: start; }
  }
</style>
