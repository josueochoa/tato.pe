---
import '../styles/global.css';
import { site } from '../lib/site';
import Menu from '../components/Menu.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  theme?: string;
  menu?: boolean;
  /** 'article' for blog notes, so WhatsApp and Facebook show them as a post with its date. */
  type?: 'website' | 'article';
  published?: Date;
}
const { title, description, image = '/poster/transformacion.jpg', theme = '#ffffff', menu = true, type = 'website', published } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
---
<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={theme} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonical)} />
    <meta property="og:type" content={type} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta property="og:locale" content="es_PE" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@800&family=Onest:wght@400;500&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    {menu && <Menu />}
    <slot />
    <script src="../scripts/motion.ts"></script>
    <script src="../scripts/clips.ts"></script>
    <script src="../scripts/cart.ts"></script>
  </body>
</html>
