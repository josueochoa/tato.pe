---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('es-PE', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={`${post.data.title} · Tato Studio`} description={post.data.description} image={post.data.cover}>
  <main class="article wrap">
    <header class="article__head">
      <a class="small medium article__mark" href="/">Tato Studio</a>
      <nav class="small medium article__nav" aria-label="Principal"><a class="link" href="/blog">Blog</a><a class="link" href="/#aprende">Aprende</a></nav>
      <h1 class="article__title">{post.data.title}</h1>
      <p class="lead article__desc">{post.data.description}</p>
      <time class="small muted" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
    </header>
    {post.data.cover && (
      <figure class="article__cover shutter" data-reveal>
        <img src={post.data.cover} alt={post.data.coverAlt ?? ''} width="1280" height="720" decoding="async" />
      </figure>
    )}
    <div class="prose article__body"><Content /></div>
    <p class="article__back"><a class="link-plain medium" href="/blog">Todas las notas</a></p>
  </main>
  <Footer />
</Base>
<style>
  .article { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); padding-top: 1.1rem; padding-bottom: calc(var(--section) / 2); }
  .article__head { grid-column: 1 / span 12; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
  .article__mark { grid-column: 1 / span 4; text-decoration: none; }
  .article__nav { grid-column: 5 / span 4; display: flex; gap: 1.5rem; }
  .article__title { grid-column: 1 / span 9; margin-top: 14vh; font-size: clamp(2rem, 4.6vw, 4.5rem); line-height: 0.95; }
  .article__desc { grid-column: 1 / span 6; margin-top: 1.25rem; }
  .article__head time { grid-column: 1 / span 6; margin-top: 1rem; }
  .article__cover { grid-column: 1 / span 12; margin: 4rem 0 0; aspect-ratio: 21 / 9; overflow: hidden; }
  .article__cover img { width: 100%; height: 100%; object-fit: cover; }
  .article__body { grid-column: 4 / span 6; margin-top: 4rem; }
  .article__back { grid-column: 4 / span 6; margin-top: 4rem; }
  @media (max-width: 47.99em) {
    .article { display: block; padding-inline: 16px; }
    .article__head { display: block; }
    .article__nav { display: none; }
    .article__title { margin-top: 10vh; font-size: 10vw; }
    .article__desc, .article__head time { display: block; margin-top: 1rem; }
    .article__cover { margin-top: 2.5rem; aspect-ratio: 4 / 5; }
    .article__body, .article__back { margin-top: 2.5rem; }
  }
</style>
