---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import BlogMotion from '../../components/blog/BlogMotion.astro';
import NoteMedia from '../../components/blog/NoteMedia.astro';
import PostGrid from '../../components/blog/PostGrid.astro';
import AprendeCta from '../../components/blog/AprendeCta.astro';
import { getCategory, categoryHref, fmtDate, readingTime } from '../../lib/blog';
import { getPosts } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}
const { post, all } = Astro.props;
const { Content } = await render(post);
const cat = getCategory(post.data.category);
// Sigue leyendo: same category first, then the newest of the rest.
const others = all.filter((p) => p.id !== post.id);
const more = [...others.filter((p) => p.data.category === post.data.category), ...others.filter((p) => p.data.category !== post.data.category)].slice(0, 3);
---
<Base title={`${post.data.title} · Tato Studio`} description={post.data.description} image={post.data.cover} type="article" published={post.data.date}>
  <BlogMotion />
  <main>
    <div data-ink="#1f1f1f">
      <header class="top wrap">
        <a class="small medium top__mark" href="/">Tato Studio</a>
        <nav class="small medium top__nav" aria-label="Principal">
          <a class="link" href="/blog">Blog</a>
          {cat && <a class="link" href={categoryHref(cat.id)}>{cat.label}</a>}
          <a class="link" href="/#aprende">Aprende</a>
        </nav>
      </header>
      <section class="hero" style={`--cat:${cat?.color ?? 'var(--surface)'}`}>
        <h1 class="hero__title wrap" data-reveal>{post.data.title}</h1>
      </section>
      <article class="nota wrap">
        <div class="nota__intro">
          <p class="lead" data-reveal style="--i:1">{post.data.description}</p>
          <p class="small nota__meta" data-reveal style="--i:2">
            {cat && <a class="link-plain medium" href={categoryHref(cat.id)}>{cat.label}</a>}
            <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
            <span>{readingTime(post.body)} min de lectura</span>
          </p>
        </div>
        <span class="nota__frame" data-reveal="scale" style="--i:2"><NoteMedia post={post} class="nota__media" eager width={720} height={1280} /></span>
        <div class="prose nota__body"><Content /></div>
      </article>
      <PostGrid posts={more} title="Sigue leyendo" cols={3} />
    </div>
    <AprendeCta />
  </main>
  <Footer />
</Base>

<style>
  .top { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); padding-block: 1.1rem 3rem; }
  .top__mark { grid-column: 1 / span 4; text-decoration: none; }
  .top__nav { grid-column: 5 / span 5; display: flex; gap: 1.5rem; }
  .hero { background: var(--cat); }
  /* Ink on the brand colours needs large type: the title never drops under 36px. */
  .hero__title { padding-block: clamp(3rem, 9vw, 8rem) clamp(2rem, 4vw, 3.5rem); font-size: clamp(2.25rem, 5.6vw, 6rem); line-height: 0.95; }
  .nota { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: auto 1fr; column-gap: var(--gutter); padding-top: clamp(2.5rem, 5vw, 4.5rem); }
  .nota__intro { grid-column: 1 / span 7; grid-row: 1; }
  .nota__meta { display: flex; flex-wrap: wrap; gap: 0.2rem 1.25rem; margin-top: 1.25rem; color: var(--muted); }
  .nota__frame { grid-column: 9 / -1; grid-row: 1 / span 2; align-self: start; position: sticky; top: 4.5rem; display: block; }
  .nota :global(.nota__media) { aspect-ratio: 9 / 16; max-height: calc(100vh - 6rem); width: 100%; }
  .nota__body { grid-column: 1 / span 7; grid-row: 2; margin-top: 2.5rem; }
  @media (max-width: 47.99em) {
    .top { display: block; padding: 1.1rem 16px 2rem; }
    .top__nav { display: none; }
    .hero__title { padding: 2.5rem 16px 2rem; font-size: 10vw; }
    .nota { display: block; padding: 2rem 16px 0; }
    .nota__frame { position: static; margin-top: 2rem; }
    .nota :global(.nota__media) { aspect-ratio: 4 / 5; max-height: none; }
    .nota__body { margin-top: 2rem; }
  }

  /* "Copiar prompt": the button is added by the script below, so these styles are global within the note. */
  .nota__body :global(.code) { margin-top: 1.25rem; }
  .nota__body :global(.code pre) { margin-top: 0.5rem; }
  .nota__body :global(.copy) {
    display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1.1rem; border: 0; border-radius: var(--radius); cursor: pointer;
    background: var(--ink); color: var(--bg); font-weight: 500; font-size: var(--step-small);
    transition: transform var(--t-press) var(--ease-out), background-color var(--t-hover) ease, color var(--t-hover) ease;
  }
  .nota__body :global(.copy:active) { transform: scale(0.96); }
  .nota__body :global(.copy.is-done) { background: var(--color-green); color: var(--ink); }
</style>

<script>
  // One tap to copy each prompt (every code block in a note is a prompt).
  document.querySelectorAll<HTMLElement>('.nota__body pre').forEach((pre) => {
    const label = 'Copiar prompt';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy';
    btn.textContent = label;
    btn.setAttribute('aria-live', 'polite');
    btn.addEventListener('click', async () => {
      const text = pre.innerText.trim();
      let ok = false;
      try { await navigator.clipboard.writeText(text); ok = true; }
      catch {
        const range = document.createRange();
        range.selectNodeContents(pre);
        const sel = getSelection();
        sel?.removeAllRanges(); sel?.addRange(range);
        try { ok = document.execCommand('copy'); } catch { ok = false; }
        sel?.removeAllRanges();
      }
      btn.textContent = ok ? 'Copiado' : 'Selecciónalo y cópialo';
      btn.classList.toggle('is-done', ok);
      setTimeout(() => { btn.textContent = label; btn.classList.remove('is-done'); }, 2200);
    });
    const box = document.createElement('div');
    box.className = 'code';
    pre.replaceWith(box);
    box.append(btn, pre);
  });
</script>
