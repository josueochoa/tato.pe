---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Footer from '../../components/Footer.astro';
import BlogMotion from '../../components/blog/BlogMotion.astro';
import CategoryBand from '../../components/blog/CategoryBand.astro';
import Feature from '../../components/blog/Feature.astro';
import PostGrid from '../../components/blog/PostGrid.astro';
import AprendeCta from '../../components/blog/AprendeCta.astro';
import { categoryHref } from '../../lib/blog';
import { getPosts } from '../../lib/posts';
const posts = await getPosts();
const [first, ...rest] = posts;
const hasPrompts = posts.some((p) => p.data.category === 'prompts');
---
<Base title="Blog · Tato Studio" description="Noticias, prompts listos para copiar, herramientas y cómo hago los personajes de mis videos con IA.">
  <BlogMotion />
  <main>
    <div data-ink="#1f1f1f">
      <PageHead title="Blog">
        Lo que aprendo haciendo videos con IA, contado corto.{hasPrompts && <> Si vienes del taller, <a class="link-plain" href={categoryHref('prompts')}>empieza por los prompts</a>.</>}
      </PageHead>
      <CategoryBand posts={posts} />
      {first && <Feature post={first} />}
      <PostGrid posts={rest} />
    </div>
    <AprendeCta />
  </main>
  <Footer />
</Base>
