---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Footer from '../../components/Footer.astro';
import CategoryNav from '../../components/blog/CategoryNav.astro';
import PostList from '../../components/blog/PostList.astro';
import { getPosts } from '../../lib/posts';
const posts = await getPosts();
---
<Base title="Blog · Tato Studio" description="Noticias, prompts, herramientas y cómo hago cada video. Notas cortas, en español.">
  <main>
    <PageHead title="Blog" intro="Noticias, los prompts de los videos, lo que cambia en cada herramienta y cómo hago los personajes. Notas cortas." />
    <CategoryNav posts={posts} />
    <PostList posts={posts} />
  </main>
  <Footer />
</Base>
