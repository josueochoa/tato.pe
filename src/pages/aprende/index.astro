---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Footer from '../../components/Footer.astro';
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Aprende · Tato Studio" description="Taller en vivo, pack de prompts y, pronto, un curso completo. Precios en soles.">
  <main>
    <PageHead title="Aprende" intro="Todo lo que hay para aprender a hacer videos con IA conmigo. Pagas por Yape, Plin o tarjeta." />
    <section class="shop wrap">
      {products.map((p, i) => (
        <a class="item" href={`/aprende/${p.id}`} data-reveal style={`--i:${i}`}>
          <img src={p.data.cover} alt={p.data.coverAlt} loading="lazy" decoding="async" width="720" height="1280" />
          <span class="item__body">
            <span class="item__title">{p.data.title}</span>
            <span>{p.data.short}</span>
            <span class="item__price nums">S/{p.data.price} {p.data.compareAt && <s class="muted">S/{p.data.compareAt}</s>}</span>
          </span>
        </a>
      ))}
    </section>
  </main>
  <Footer />
</Base>
<style>
  .shop { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 4rem; padding-block: 5rem calc(var(--section) / 2); }
  .item { grid-column: span 6; display: grid; grid-template-columns: 2fr 3fr; gap: var(--gutter); text-decoration: none; align-items: start; }
  .item img { aspect-ratio: 4 / 5; object-fit: cover; width: 100%; height: auto; }
  .item__body { display: flex; flex-direction: column; gap: 0.75rem; }
  .item__title { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: -0.03em; font-size: clamp(1.25rem, 1.8vw, 1.75rem); line-height: 1; }
  .item__price { font-weight: 500; font-size: var(--step-lead); }
  @media (max-width: 47.99em) { .shop { display: flex; flex-direction: column; gap: 3rem; padding: 3rem 16px; } }
</style>
