---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Videos from '../components/home/Videos.astro';
import Prompt from '../components/home/Prompt.astro';
import Aprende from '../components/home/Aprende.astro';
import Hazlo from '../components/home/Hazlo.astro';
import TuVideo from '../components/home/TuVideo.astro';
import Marcas from '../components/home/Marcas.astro';
